---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Something went wrong — Trainory" description="Trainory hit an unexpected error while loading this page. Try again shortly or contact the developer." noindex>
  <div class="mx-auto flex w-full max-w-md flex-1 flex-col items-center justify-center px-4 py-24 text-center">
    <p class="eyebrow">Error 500</p>
    <h1 class="mt-3 text-3xl tracking-tight">Something went wrong</h1>
    <p class="mt-3 leading-7">The site hit an unexpected error. Try again in a moment, and let us know if it keeps happening.</p>
    <div class="mt-7 flex gap-3">
      <a href="/" class="btn btn-primary btn-pill">Go home</a>
      <a href="/contact/" class="btn btn-pill">Contact</a>
    </div>
  </div>
</Layout>
