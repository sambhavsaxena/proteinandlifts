---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Protein & Lifts" description="The page you were looking for on Protein & Lifts does not exist. Go back to the homepage or get in touch." noindex>
  <div class="mx-auto flex w-full max-w-md flex-1 flex-col items-center justify-center px-4 py-24 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-3xl tracking-tight">Page not found</h1>
    <p class="mt-3 leading-7">That page does not exist, or it has moved. Head back and pick up where you left off.</p>
    <div class="mt-7 flex gap-3">
      <a href="/" class="btn btn-primary btn-pill">Go home</a>
      <a href="/contact/" class="btn btn-pill">Contact</a>
    </div>
  </div>
</Layout>
